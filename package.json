{
  "name": "zhuyin-spire",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "simulate:resonance": "node scripts/simulate-resonance-pool.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:setup": "playwright install --with-deps chromium firefox webkit",
    "test:e2e": "playwright test",
    "test:security:e2e": "npm run build && playwright test --config=playwright.security.config.ts",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=11.19.1"
  },
  "packageManager": "npm@11.19.1"
}
